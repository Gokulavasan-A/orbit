# Copy to .env.production (or set at build time). Every VITE_* value is compiled into the
# public bundle: never put secrets here.

# Origin of enterprise-api, without a trailing slash. Must be on the same site as the UI.
VITE_API_BASE_URL=https://api.company.com
VITE_APP_NAME=Enterprise Base
# Must match app.security.auth.session.idle-timeout on the API (default 30m).
VITE_SESSION_IDLE_TIMEOUT_MINUTES=30
# How long before the idle timeout the warning dialog appears.
VITE_SESSION_IDLE_WARNING_SECONDS=120
